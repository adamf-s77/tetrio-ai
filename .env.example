# ============================================================
# Tetris MCTS AI 參數設定範本 (.env.example)
# ============================================================

# MCTS 運算預算 (0 表示自動全候選動作覆蓋，速度最快且最穩定，約 9~34 次探索)
TETRIS_MCTS_BUDGET=0

# 高度懲罰程度權重 (數值越高越積極壓低高度防暴斃，建議: 1.0)
TETRIS_HEIGHT_PUNISHMENT=1.0

# MCTS 回溯衰減因子 (類似強化學習 gamma，建議: 0.95)
TETRIS_BACKUP_PUNISHMENT=0.95

# 瀏覽器設定 (可選: edge 或 chrome)
TETRIS_BROWSER=edge

# 目標消除行數 (預設: 300)
TETRIS_TARGET_LINES=300

# ============================================================
# 網頁實機辨識座標設定 (針對 1920x1080 視窗)
# ============================================================
NEXT_PIECE_X=1210
NEXT_PIECE_Y=350
NEXT_PIECE_WIDTH=95
NEXT_PIECE_HEIGHT=96

# 盤面生成點區域 (開局第一塊偵測)
SPAWN_AREA_X=910
SPAWN_AREA_Y=260
SPAWN_AREA_WIDTH=100
SPAWN_AREA_HEIGHT=80
